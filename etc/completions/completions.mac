# @@Description      :  Enables bash-completion on macOS
# @@Changelog        :  standardized header to WTFPL @@-field template
# @@TODO             :
# @@Other            :
# @@Resource         :
# @@Terminal App     :  no
# @@sudo/root        :  no
# @@Template         :  shell/bash
# - - - - - - - - - - - - - - - - - - - - - - - -
# shellcheck disable=SC1001,SC1003,SC2001,SC2003,SC2016,SC2031,SC2090,SC2115,SC2120,SC2155,SC2199,SC2229,SC2317,SC2329
# - - - - - - - - - - - - - - - - - - - - - - - -
VERSION="202609031517-git"
if [ -n "${BASH_VERSION-}" ] && [ -n "${PS1-}" ] && [ -z "${BASH_COMPLETION_VERSINFO-}" ]; then
  if [ "${BASH_VERSINFO[0]}" -gt 4 ] || [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -ge 1 ]; then
    if [ -f "/usr/local/etc/bash_completion" ]; then
      . "/usr/local/etc/bash_completion"
    fi
    # Use directory test instead of slow find command
    if [ -d "/etc/bash_completion.d" ] && [ ! -f "/etc/bash_completion" ]; then
      shopt -s nullglob
      for f in "/etc/bash_completion.d"/*; do
        [ -f "$f" ] && . "$f"
      done
      shopt -u nullglob
    fi
  fi
fi
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# end
