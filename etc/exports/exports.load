export MISC_SCRIPTS_LOADED_EXPORTS="true"
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
if [ -f "$HOME/.config/misc/shell/exports/00-exports.load" ]; then
  . "$HOME/.config/misc/shell/exports/00-exports.load"
else
  # - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
  __source_os_files "$HOME/.config/bash/exports"
fi
