#!/usr/bin/env bash
# shellcheck shell=bash
# shellcheck disable=SC1087
# shellcheck disable=SC2317
# shellcheck disable=SC2120
# shellcheck disable=SC2155
# shellcheck disable=SC2199
# shellcheck disable=SC2034 # palette vars (FG_*, BG_*, DIM, REVERSE, BOLD) come from 00-powerline-colors.bash and are used via PS1 interpolation
# shellcheck disable=SC2153 # RESET is set by __powerline_colors (00-powerline-colors.bash), not a typo of "reset"
# shellcheck disable=SC1091 # powerline.sh paths are external, guarded by -f checks, not part of this repo
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
##@Version       : 202103251632-git
# @Author        : Jason Hempstead
# @Contact       : jason@casjaysdev.pro
# @License       : LICENSE.md
# @ReadME        : 01-powerline.win --help
# @Copyright     : Copyright: (c) 2021 Jason Hempstead, CasjaysDev
# @Created       : Thursday, Mar 25, 2021 18:01 EDT
# @File          : 01-powerline.win
# @Description   :
# @TODO          :
# @Other         :
# @Resource      :
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
#Powerline check
if [ "$POWERLINE" ]; then
  #Debian/Ubuntu/Arch
  if [ -f /usr/share/powerline/bindings/bash/powerline.sh ]; then
    source /usr/share/powerline/bindings/bash/powerline.sh
  fi
  #Redhat/CentOS
  if [ -f /usr/share/powerline/bash/powerline.sh ]; then
    source /usr/share/powerline/bash/powerline.sh
  fi
  #MacOS
  if [ -f /usr/local/lib/python3.7/site-packages/powerline/bindings/bash/powerline.sh ]; then
    source /usr/local/lib/python3.7/site-packages/powerline/bindings/bash/powerline.sh
  fi
  powerline-daemon -q
  export POWERLINE_BASH_CONTINUATION=1
  export POWERLINE_BASH_SELECT=1
fi
# Borrowed and customized from https://github.com/riobard/bash-powerline
__powerline() {
  # Unicode symbols
  readonly PS_SYMBOL_DARWIN='' 2>/dev/null
  readonly PS_SYMBOL_LINUX='🐧 ' >/dev/null
  readonly PS_SYMBOL_OTHER='%' 2>/dev/null
  readonly GIT_BRANCH_SYMBOL='⑂' 2>/dev/null
  readonly GIT_BRANCH_CHANGED_SYMBOL='+' 2>/dev/null
  readonly GIT_NEED_PUSH_SYMBOL='⇡' 2>/dev/null
  readonly GIT_NEED_PULL_SYMBOL='⇣' 2>/dev/null
  readonly RUBY_SYMBOL='⬙' 2>/dev/null
  readonly NODE_SYMBOL='⬢' 2>/dev/null
  readonly PYTHON_SYMBOL='🐍' 2>/dev/null
  readonly PHP_SYMBOL='🕸️' 2>/dev/null
  # Foreground/Background colors (shared with 01-powerline.bash)
  __powerline_colors
  # what OS?
  case "$(uname)" in
  Darwin)
    readonly PS_SYMBOL=$PS_SYMBOL_DARWIN
    ;;
  Linux)
    readonly PS_SYMBOL=$PS_SYMBOL_LINUX
    ;;
  *)
    readonly PS_SYMBOL=$PS_SYMBOL_OTHER
    ;;
  esac
  ### Git ########################################################
  if [ -n "$(type -P git 2>/dev/null)" ]; then
    __git_version() { printf '%s' "$(git --version | awk '{print $3}')"; }
  fi
  __git_info() {
    # git not found
    [ -n "$(type -P git 2>/dev/null)" ] || return
    # force git output in English to make our work easier
    local git_eng="env LANG=C git"
    # get current branch name or short SHA1 hash for detached head
    local branch="$($git_eng symbolic-ref --short HEAD 2>/dev/null || $git_eng describe --tags --always 2>/dev/null)"
    # git branch not found
    [ -n "$branch" ] || return
    local marks raw
    # one status call covers both the dirty check and the branch/ahead/behind marker
    raw="$($git_eng status --porcelain --branch 2>/dev/null)"
    grep -qv '^##' <<<"$raw" && marks+=" $GIT_BRANCH_CHANGED_SYMBOL"
    local stat="$(grep '^##' <<<"$raw" | grep -o '\[.\+\]$')"
    local aheadN="$(grep -o 'ahead [[:digit:]]\+' <<<"$stat" | grep -o '[[:digit:]]\+')"
    local behindN="$(grep -o 'behind [[:digit:]]\+' <<<"$stat" | grep -o '[[:digit:]]\+')"
    [ -n "$aheadN" ] && marks+=" $GIT_NEED_PUSH_SYMBOL$aheadN"
    [ -n "$behindN" ] && marks+=" $GIT_NEED_PULL_SYMBOL$behindN"
    printf '%s' " $GIT_BRANCH_SYMBOL $branch$marks"
  }
  ### PROMPT #####################################################
  __title_info() { echo -ne "${USER}@${HOSTNAME%%.*}:${PWD/#$HOME/~}"; }
  case $TERM in
  xterm* | rxvt | Eterm | eterm)
    title() { echo -ne "\033]0;$(__title_info)\007"; }
    ;;
  screen)
    title() { echo -ne "\033_$(__title_info)\033\\"; }
    ;;
  esac
  ps1() {
    local exit_code=$?
    local bold=$(tput bold 2>/dev/null)
    local reset=$(tput sgr0 2>/dev/null)
    local cyan=""
    local green=""
    local orange=""
    local white=""
    local yellow=""
    # - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
    if [ "$(tput colors 2>/dev/null || printf "0")" -ge 256 ]; then
      cyan=$(tput setaf 37)
      green=$(tput setaf 64)
      orange=$(tput setaf 166)
      white=$(tput setaf 15)
      yellow=$(tput setaf 136)
      red=$(tput setaf 1)
      purple=$(tput setaf 5)
    fi
    # Check the exit code of the previous command and display different
    # colors in the prompt accordingly.
    if [ "$exit_code" -eq 0 ]; then
      local BG_EXIT="$BG_DARK_GREEN"
    else
      local BG_EXIT="$BG_RED"
    fi
    PS_LINE=$(printf -- '- %.0s' {1..2000})
    PS_FILL=${PS_LINE:0:$COLUMNS}
    PS_TIME="\[\033[\$((COLUMNS-10))G\]$red[\t]$RESET"
    PS1="\${PS_FILL}\[\033[0G\]"
    PS1+="$RESET"
    PS1+="$BG_BLACK$FG_GRAY3 \s: \v $RESET"
    PS1+="$BG_CYAN$FG_BLACK Git $(__git_version) $(__git_info)$RESET"
    PS1+="$BG_BLACK$FG_PURPLE${PS_TIME}$RESET"
    PS1+="$RESET$BG_GRAY2$FG_BLACK \u@\H:$BG_DARK_GREEN\w$RESET\n"
    PS1+="$BG_EXIT$FG_GRAY1 Jobs:[\j]$PS_SYMBOL$RESET"
  }
  PROMPT_COMMAND="ps1 && title"
}
__powerline 2>/dev/null
unset __powerline
# - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
# end
